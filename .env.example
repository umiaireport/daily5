DATA_MODE=synthetic
PROJECT_ID=daily5
APP_PORT=8311
API_PORT=8411
HOST=127.0.0.1
# Durable PostgreSQL target for a database adapter that supports it.
# The current local fallback uses DATABASE_PATH and Node 24 node:sqlite.
# DATABASE_URL=postgresql://daily5:change-me@127.0.0.1:5432/daily5
DATABASE_PATH=./data/daily5.sqlite
# Primary Nansen API key name. Keep the value local and never commit .env.
NANSEN_API=
# Legacy aliases accepted for older workspace setups; NANSEN_API wins when both are set.
NANSEN_API2=
NANSEN_API_KEY=
# Normal live requests have a conservative guard. The one-time Daily Five
# download uses DAILY_FIVE_DOWNLOAD_BUDGET instead.
NANSEN_CREDIT_BUDGET=10
# Optional and expensive: enable only when the Hunt live discovery feed is needed.
NANSEN_LIVE_HUNT=false
DAILY_FIVE_PROVIDER_SNAPSHOT=./data/daily-five-provider-demo.json
# Set only for the one-time `npm run download:daily-five` command.
DAILY_FIVE_DOWNLOAD=false
DAILY_FIVE_DOWNLOAD_BUDGET=160
# Completed provider windows avoid unsettled current-day data by default.
DAILY_FIVE_HISTORY_LAG_DAYS=2
ADMIN_TOKEN=
