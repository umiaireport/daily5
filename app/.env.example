# NANSEN_CREDIT_BUDGET=optional-integer
DAILY_FIVE_PROVIDER_SNAPSHOT=./data/daily-five-provider-demo.json
# Historical windows are collected this many complete days behind UTC today.
DAILY_FIVE_HISTORY_LAG_DAYS=2
ADMIN_TOKEN=
