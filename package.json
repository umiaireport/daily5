{
  "name": "daily5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 8311 --strictPort\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{web,server,shared,fixtures,tests}/**/*.{ts,tsx,css}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"{web,server,shared,fixtures,tests}/**/*.{ts,tsx,css}\" \"*.{ts,json}\"",
    "build": "npm run typecheck && vite build",
    "submission:check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "download:daily-five": "node --import tsx scripts/download-daily-five.ts",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts tests/*.test.tsx tests/daily-five-ui.spec.ts tests/hunt-ui.spec.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/db/migrate.ts",
    "reset:daily-five": "node --import tsx scripts/reset-daily-five.ts",
    "worker": "tsx server/jobs/worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
      "@fastify/static": "10.1.3",
      "@types/node": "26.6.0",
      "fastify": "5.12.4",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "vite": "8.3.0",
      "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
